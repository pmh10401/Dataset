  "sources": [
    {
      "id": "variant_metrics",
      "label": "Exp408 variant metrics",
      "query": {
        "language": "sql",
        "engine": "duckdb",
        "sql": "SELECT\n  variant,\n  alpha,\n  SUM(candidate_count) AS candidates,\n  SUM(tp) AS tp,\n  SUM(fp) AS fp,\n  SUM(tp) / NULLIF(SUM(candidate_count), 0) AS precision,\n  SUM(zero_f1_before) - SUM(zero_f1_after) AS zero_recovered,\n  SUM(review_outside_existing) / NULLIF(SUM(candidate_count), 0) AS outside_share\nFROM read_csv_auto('exp408_variant_metrics.csv')\nGROUP BY variant, alpha\nORDER BY variant, alpha",
        "description": "exp408_variant_metrics.csv의 동결 행을 읽어 dataset·variant·alpha 단위로 재집계",
        "tables_used": [
          "exp408_variant_metrics.csv"
        ],
        "filters": [
          "Exp408 frozen publication only",
          "No candidate promotion; retrospective review-only interpretation"
        ],
        "metric_definitions": [
          "precision = sum(tp) / sum(candidate_count)",
          "zero_recovered = sum(zero_f1_before) - sum(zero_f1_after)",
          "outside_share = sum(review_outside_existing) / sum(candidate_count)"
        ]
      }
    },
    {
      "id": "candidate_evaluation",
      "label": "Exp408 candidate evaluation",
      "query": {
        "language": "sql",
        "engine": "duckdb",
        "sql": "SELECT\n  dataset,\n  variant,\n  alpha,\n  COUNT(*) AS candidate_rows,\n  SUM(is_true_anomaly) AS tp,\n  COUNT(*) - SUM(is_true_anomaly) AS fp\nFROM read_csv_auto('exp408_variant_candidate_evaluation.csv')\nGROUP BY dataset, variant, alpha",
        "description": "exp408_variant_candidate_evaluation.csv의 동결 행을 읽어 dataset·variant·alpha 단위로 재집계",
        "tables_used": [
          "exp408_variant_candidate_evaluation.csv"
        ],
        "filters": [
          "Exp408 frozen publication only",
          "No candidate promotion; retrospective review-only interpretation"
        ],
        "metric_definitions": [
          "One row per dataset, variant, alpha, candidate_index",
          "candidate TP = sum(is_true_anomaly)"
        ]
      }
    },
    {
      "id": "consensus_results",
      "label": "Exp408 consensus results",
      "query": {
        "language": "sql",
        "engine": "duckdb",
        "sql": "SELECT dataset, outcome, eligibility, train_size, consensus.source_statuses\nFROM read_json_auto('exp408_consensus_results.jsonl')\nORDER BY dataset",
        "description": "exp408_consensus_results.jsonl의 동결 행을 읽어 dataset·variant·alpha 단위로 재집계",
        "tables_used": [
          "exp408_consensus_results.jsonl"
        ],
        "filters": [
          "Exp408 frozen publication only",
          "No candidate promotion; retrospective review-only interpretation"
        ],
        "metric_definitions": [
          "One row per dataset",
          "Every completed row must expose exactly 13 source statuses"
        ]
      }
    }
  ]
}
